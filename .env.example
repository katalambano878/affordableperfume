# Plain PostgreSQL (Coolify / self-hosted)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/affordableperfume
# POSTGRES_URL=  # optional alias for DATABASE_URL
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=10000
PG_STATEMENT_TIMEOUT_MS=30000
# PGSSL=require

# Dual-mode / shim (browser talks to app origin, not hosted supabase.co)
NEXT_PUBLIC_USE_PLAIN_PG=true
NEXT_PUBLIC_SUPABASE_URL=https://www.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-anon-or-shim-key
SUPABASE_SERVICE_ROLE_KEY=server-only-do-not-expose

# Auth JWT for plain-PG mode
AUTH_JWT_SECRET=change-me-long-random
# JWT_SECRET=  # fallback accepted by lib/db/mode.ts

# App URLs
NEXT_PUBLIC_APP_URL=https://www.example.com

# Local file storage (replaces Supabase Storage)
STORAGE_ROOT=.storage
STORAGE_PUBLIC_URL=

# Moolre payments + SMS
MOOLRE_API_USER=
MOOLRE_API_PUBKEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_CALLBACK_SECRET=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_SMS_API_KEY=
MOOLRE_SMS_SENDER_ID=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=
